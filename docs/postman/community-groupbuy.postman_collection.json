              "raw": "{\n  \"username\": \"testuser_{{$timestamp}}\",\n  \"password\": \"123456\",\n  \"realName\": \"接口测试用户\",\n  \"phone\": \"13900000000\",\n  \"roleCode\": \"ROLE_RESIDENT\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {

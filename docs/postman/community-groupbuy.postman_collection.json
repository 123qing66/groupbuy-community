    {
      "name": "02 活动（A #3 #4 #5 #6）",
      "description": "浏览侧 GET 免登录；开团、状态流转必须带 token（团长）。",
      "item": [
        {
          "name": "① 活动列表（分页）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('code = 0', () => pm.expect(res.code).to.eql(0));",
                  "const list = res.data.list || [];",
                  "if (list.length) {",
                  "  const ids = list.map(x => String(x.id));",
                  "  const cur = String(pm.environment.get('activityId') || '');",
                  "  if (ids.indexOf(cur) === -1) {",
                  "    pm.environment.set('activityId', ids[0]);",
                  "    console.log('{{activityId}} 原值 ' + cur + ' 不在库里，已自动切到 ' + ids[0] + '（下一 条详情会用它）');",
                  "  }",
                  "}",
                  "pm.test('返回分页结构 total/pages/list', () => {",
                  "  pm.expect(res.data).to.have.property('total');",
                  "  pm.expect(res.data).to.have.property('pages');",
                  "  pm.expect(res.data).to.have.property('list');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/activities?pageNum=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "activities"],
              "query": [
                { "key": "pageNum", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "description": "免登录（居民没登录也要能逛）。分页字段统一 `PageResult{total, pages, list}`。"

                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('code = 0', () => pm.expect(res.code).to.eql(0));",
                  "console.log('说明：JWT 无状态，服务端不维护黑名单，客户端删掉 token 即视为退出（登出后拿旧 token 仍可访问，属于设计取舍）');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "清掉本地 token 即可。答辩若被问「JWT 怎么登出」：答无状态 + 短 TTL，要做强制下线就加 Redis 黑名单（按 jti 存到过期时刻）。"
          }
        }
      ]

.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# 系统与编辑器
.DS_Store
Thumbs.db
*.swp

# 本地上传与临时文件
uploads/
tmp/

# 压测与演示产物（需要入档的放 docs/evidence/）

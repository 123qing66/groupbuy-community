# Maven 构建产物
target/
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# 编译产物
*.class
*.log
*.jar
!.mvn/wrapper/maven-wrapper.jar

# 本地环境与密钥（严禁入库）
.env
*.env
application-local.yml
application-local.properties

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json


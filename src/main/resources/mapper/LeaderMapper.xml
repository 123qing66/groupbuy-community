<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.groupbuy.mapper.LeaderMapper">

    <sql id="Base_Column_List">
        id, user_id, point_id, community, status, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.groupbuy.entity.Leader"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO leader (user_id, point_id, community, status)
        VALUES (#{userId}, #{pointId}, #{community}, 1)
    </insert>

    <select id="selectById" resultType="com.groupbuy.entity.Leader">
        SELECT
        <include refid="Base_Column_List"/>
        FROM leader WHERE id = #{id}
    </select>

    <select id="selectByUserId" resultType="com.groupbuy.entity.Leader">
        SELECT
        <include refid="Base_Column_List"/>
        FROM leader WHERE user_id = #{userId}
    </select>

    <select id="selectByPointId" resultType="com.groupbuy.entity.Leader">
        SELECT
        <include refid="Base_Column_List"/>
        FROM leader WHERE point_id = #{pointId} AND status = 1
    </select>

    <update id="bindPoint">
        UPDATE leader
        SET point_id = #{pointId}, update_time = NOW()
        WHERE id = #{id}
    </update>

</mapper>
